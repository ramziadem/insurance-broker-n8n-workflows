    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\nconst items = $input.all();\n\n// Set today to midnight for exact day calculation\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nreturn items.map(item => {\n  const row = item.json;\n\n  const expDateStr = row.Expiration_Date || row.expiration_date;\n  const lastContactedStr = row.Last_Contacted || row.last_contacted_date || row.Last_Contacted_Date;\n  const rawFollowup = row.Followup_Count !== undefined && row.Followup_Count !== \"\" && row.Followup_Count !== null \n    ? row.Followup_Count \n    : row.followup_count;\n\n  // Handle missing expiration dates\n  if (!expDateStr) {\n    return {\n      json: {\n        ...row,\n        days_to_expiration: null,\n        days_since_last_contact: null,\n        is_eligible: false\n      }\n    };\n  }\n\n  // Calculate days to expiration\n  const expDate = new Date(expDateStr);\n  expDate.setHours(0, 0, 0, 0);\n  const daysToExpiration = Math.round((expDate - today) / (1000 * 60 * 60 * 24));\n\n  // Robust parsing for Last_Contacted date\n  let daysSinceLastContact = 999;\n  if (lastContactedStr && String(lastContactedStr).trim() !== \"\") {\n    // Strip out broken non-standard prefixes like \"08-\" from \"08-Aug 27, 2026\"\n    const cleanDateStr = String(lastContactedStr).replace(/^[0-9]{2}-/, '').trim();\n    const parsedLastContacted = new Date(cleanDateStr);\n\n    // Only calculate if the resulting date string is valid and not in the future\n    if (!isNaN(parsedLastContacted.getTime())) {\n      parsedLastContacted.setHours(0, 0, 0, 0);\n      const diff = Math.round((today - parsedLastContacted) / (1000 * 60 * 60 * 24));\n      // If calculated diff is negative (corrupted future date), treat as uncontacted (999)\n      daysSinceLastContact = diff < 0 ? 999 : diff;\n    }\n  }\n\n  const followupCount = parseInt(rawFollowup || 0, 10);\n\n  // Check eligibility rule: <= 30 days left, >= 0 days, < 4 followups, 7+ days since last email\n  const isEligible = daysToExpiration <= 30 && daysToExpiration >= 0 && followupCount < 4 && daysSinceLastContact >= 7;\n\n  return {\n    json: {\n      ...row,\n      days_to_expiration: daysToExpiration,\n      days_since_last_contact: daysSinceLastContact,\n      is_eligible: isEligible,\n      new_followup_count: isEligible ? followupCount + 1 : followupCount\n    }\n  };\n});"
      },
