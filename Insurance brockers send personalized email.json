    {
      "parameters": {
        "jsCode": "// Merges Gemini AI output back with original client data from the Filter node\nconst body = $input.first().json.content.parts[0].text\n    .replace(/---[\\s\\S]*$/g, '') // Removes anything after '---'\n    .replace(/This email was sent automatically.*/gi, '') // Removes 'sent automatically' lines\n    .replace(/sent with n8n.*/gi, '') // Removes 'n8n' references\n    .trim();\n  return {\n    json: {\n      policy_id: $('Filter').first().json.Policy_ID,\n      full_name: $('Filter').first().json.Full_Name,\n      email: $('Filter').first().json.Email,\n      policy_type: $('Filter').first().json.Policy_Type,\n      email_subject: 'Action Required: Renewal Notice for ' + $('Filter').first().json.Policy_Type,\n      email_body: body,\n    }\n  };"
      },
