    {
      "parameters": {
        "jsCode": "// 1. Get raw text and parse JSON from AI output\nconst rawText = $input.first().json.content.parts[0].text;\nconst cleanText = rawText.replace(/```json|```/gi, '').trim();\nconst parsed = JSON.parse(cleanText);\n\n// 2. Generate Unique Policy ID (e.g., POL-9F83A2)\nconst randomCode = Math.random().toString(36).substring(2, 8).toUpperCase();\nconst uniquePolicyId = `POL-${randomCode}`;\n\n// 3. Sanitize phone number (keeps leading '+' for country codes, strips spaces/symbols, prepends ' for Sheets)\nconst rawPhone = parsed.phone || \"\";\nconst cleanPhone = rawPhone.startsWith('+') \n  ? '+' + rawPhone.replace(/[^\\d]/g, '') \n  : rawPhone.replace(/[^\\d]/g, '');\nconst formattedPhone = cleanPhone ? `'${cleanPhone}` : \"\";\n\n// 4. Return combined flattened object ready for Google Sheets\nreturn [\n  {\n    json: {\n      policy_id: uniquePolicyId,\n      full_name: parsed.full_name || \"\",\n      email: parsed.email || \"\",\n      phone: formattedPhone,\n      policy_type: parsed.policy_type || \"\",\n      policy_status: parsed.policy_status || \"ACTIVE\",\n      issue_date: parsed.issue_date || \"\",\n      expiration_date: parsed.expiration_date || \"\",\n      followup_count: 0,\n      renewal_status: \"Active\",\n      last_contacted_date: \"\"\n    }\n  }\n];"
      },
