      "parameters": {
        "fromEmail": "contact@paxonflow.dev",
        "toEmail": "={{ $json.email }}",
        "subject": "=Thank you so much for your confirmation",
        "html": "=<div style=\"background-color: #f8fafc; padding: 30px 10px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\">\n  <div style=\"max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);\">\n    \n    <div style=\"background-color: #0f172a; padding: 24px 32px; text-align: left;\">\n      <h1 style=\"color: #ffffff; font-size: 16px; font-weight: 600; margin: 0; letter-spacing: 0.5px;\">POLICY RENEWAL Confirmation</h1>\n    </div>\n\n    <div style=\"padding: 32px; color: #334155; font-size: 15px; line-height: 1.6;\">\n      <p style=\"margin-top: 0; font-weight: 600; color: #0f172a;\">To: {{ $json.name }}</p>\n\n      <!-- Suggested Reply Block (professional, ready-to-send) -->\n      <div style=\"background-color: #f1f5f9; border-left: 4px solid #10b981; padding: 16px 20px; border-radius: 4px; margin: 20px 0;\">\n        <p style=\"margin: 0; font-size: 15px; color: #0f172a; font-weight: 500;\">\n          Dear {{ $json.name }},<br><br>\n          Thank you for contacting Prime Insurance regarding your insurance policy. We have received your message and understand that You want to renew it. Our team is reviewing the details and will follow up with any required next steps within 2 business days.<br><br>\n          If you can provide any supporting documents or additional information, please reply to this email or upload them through your policy portal so we can resolve this matter more quickly. For urgent concerns, you may call our support line at 1-800-123-4567.<br><br>\n          Thank you for your patience and for choosing Prime Insurance.<br><br>\n          Sincerely,<br>\n          Prime Insurance Support Team\n        </p>\n      </div>\n    </div>\n\n    <div style=\"background-color: #f8fafc; padding: 16px 32px; border-top: 1px solid #e2e8f0; text-align: center; font-size: 12px; color: #94a3b8;\">\n      <p style=\"margin: 0; font-weight: 600; color: #64748b;\">Prime Insurance Services</p>\n    </div>\n\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
